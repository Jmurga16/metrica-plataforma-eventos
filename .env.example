# Copy this file to .env before running Docker Compose.
# These values are intentionally local-only examples. Replace every secret outside local development.

POSTGRES_PASSWORD=postgres-local-password

ConnectionStrings__EventsDb=Host=db;Port=5432;Database=events_db;Username=events_app;Password=events-local-password
ConnectionStrings__NotificationsDb=Host=db;Port=5432;Database=notifications_db;Username=notifications_app;Password=notifications-local-password

RabbitMq__Host=rabbitmq
RabbitMq__User=events
RabbitMq__Password=rabbitmq-local-password

Redis__ConnectionString=redis:6379,abortConnect=false,connectTimeout=200

Jwt__Issuer=events-platform-local
Jwt__Audience=events-api
Jwt__SigningKey=local-development-signing-key-change-me-32-bytes-minimum

Smtp__Host=mailpit
Smtp__Port=1025
Notifications__Email__To=operaciones@example.com

Database__ApplyMigrationsOnStartup=true
Cors__AllowedOrigins=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

VITE_API_BASE_URL=http://localhost:5001
