{
  "ConnectionStrings": {
    "NotificationsDb": "Host=localhost;Port=5432;Database=notifications_db;Username=notifications_app;Password=notifications-local-password"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "guest",
    "Password": "guest",
    "RetryIntervalsMilliseconds": [1000, 5000, 15000]
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false
  },
  "Notifications": {
    "Email": {
      "From": "events@localhost",
      "To": "admin@localhost",
      "TimeZone": "America/Lima",
      "TimeoutSeconds": 10
    }
  },
  "Jwt": {
    "Issuer": "events-platform-local",
    "Audience": "events-api",
    "SigningKey": "local-development-key-change-me-32-bytes-minimum"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
